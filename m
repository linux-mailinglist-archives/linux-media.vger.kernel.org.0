> > +/**
> > + * dell5285_gnvs_find - Locate the GNVS OperationRegion by
> > scanning DSDT and SSDTs.
> > + * @addr: Output: physical base address of the GNVS region.
> > + * @size: Output: byte length of the GNVS region.
> > + *
> > + * Returns true if the GNVS region was found in any ACPI table.
> > + */
> > +static bool dell5285_gnvs_find(phys_addr_t *addr, u32 *size)
> > +{
> > +	struct acpi_table_header *tbl;
> > +	u32 i;
> > +
> > +	/* DSDT */
> > +	if (ACPI_SUCCESS(acpi_get_table(ACPI_SIG_DSDT, 1, &tbl)))
> > {
> > +		bool found =3D dell5285_gnvs_from_table(tbl, addr,
> > size);
> > +
> > +		acpi_put_table(tbl);
> > +		if (found)
> > +			return true;
> > +	}
> > +
> > +	/* SSDTs (instance numbers start at 1, stop at first
> > failure) */
> > +	for (i =3D 1; i <=3D 32; i++) {
> > +		bool found;
> > +
> > +		if (ACPI_FAILURE(acpi_get_table(ACPI_SIG_SSDT, i,
> > &tbl)))
> > +			break;
> > +		found =3D dell5285_gnvs_from_table(tbl, addr, size);
> > +		acpi_put_table(tbl);
> > +		if (found)
> > +			return true;
> > +	}
> > +
> > +	return false;
> > +}
